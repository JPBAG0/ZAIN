{
  "functions": {
    "api/pedidos.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "Content-Security-Policy": "frame-ancestors 'self'"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "zain-amber-sigma.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://zain.com.mx/$1"
      }
    },
    {
      "src": "/e/?",
      "status": 302,
      "headers": {
        "Location": "/?utm_source=etiqueta&utm_medium=qr&utm_campaign=prenda",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/privacidad(?:\\.html)?",
      "dest": "/privacidad.html"
    },
    {
      "src": "/taller-zain(?:\\.html)?",
      "dest": "/taller-zain.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'"
      }
    },
    {
      "src": "/gestion-zain(?:\\.html)?",
      "dest": "/gestion-zain.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'"
      }
    },
    {
      "src": "/mi-pedido(?:\\.html)?",
      "dest": "/mi-pedido.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'"
      }
    },
    {
      "src": "/pedidos(?:\\.html)?",
      "dest": "/pedidos.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'"
      }
    },
    {
      "src": "/(server|supabase|tests|docs|scripts)(/.*)?",
      "status": 404
    },
    {
      "src": "/\\..*",
      "status": 404
    },
    {
      "src": "/sw-gestion\\.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Type": "text/javascript; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/gestion\\.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ]
}
