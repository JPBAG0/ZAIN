{
  "functions": {
    "api/pedidos.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "zain-amber-sigma.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://zain.com.mx/$1"
      }
    },
    {
      "src": "/taller-zain(?:\\.html)?",
      "dest": "/taller-zain.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/gestion-zain(?:\\.html)?",
      "dest": "/gestion-zain.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/mi-pedido(?:\\.html)?",
      "dest": "/mi-pedido.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/pedidos(?:\\.html)?",
      "dest": "/pedidos.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/(server|supabase|tests|docs)(/.*)?",
      "status": 404
    },
    {
      "src": "/\\..*",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ]
}
